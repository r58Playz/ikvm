[submodule "ext/jtreg"]
	path = ext/jtreg
	url = https://github.com/ikvmnet/jtreg.git
	ignore = dirty
	shallow = true
[submodule "ext/freetype"]
	path = ext/freetype
	url = https://gitlab.freedesktop.org/freetype/freetype.git
	ignore = dirty
	shallow = true
[submodule "ext/openjdk25"]
	path = ext/openjdk25
	url = https://github.com/openjdk/jdk25u.git
	ignore = dirty
	shallow = true
