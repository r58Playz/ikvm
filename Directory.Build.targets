<Project>
    <Import Project="targets\ClangProjectReference.targets" />
    <Import Project="targets\DotNetOSXCodeSign.targets"/>

    <!-- The build targets .NET 8 and later only (and netstandard2.0, where a project has it). -->
    <PropertyGroup Condition=" '$(TargetFrameworks)' != '' ">
        <_IkvmTargetFrameworks>$([MSBuild]::Unescape($([System.Text.RegularExpressions.Regex]::Replace(';$(TargetFrameworks);', ';(net4[0-9]+|net6\.0|net7\.0)(?=;)', '').Trim(';'))))</_IkvmTargetFrameworks>
        <TargetFrameworks Condition=" '$(_IkvmTargetFrameworks)' != '' ">$(_IkvmTargetFrameworks)</TargetFrameworks>
    </PropertyGroup>

    <!-- An IKVM project (a JRE tool, a test library) compiles its Java with the javac of the JDK the build finds, as
         IKVM.Java does (IKVM.Java.runtime.targets), instead of an IsJavaCompiler tool reference. -->
    <Target Name="_IkvmJavaCompiler" Condition=" '$(JavaCompilerPath)' == '' ">
        <FindJdk Family="$(IkvmJdk)">
            <Output TaskParameter="JdkPath" PropertyName="_IkvmJdkPath" />
        </FindJdk>
        <PropertyGroup>
            <JavaCompilerPath Condition=" '$([MSBuild]::IsOSUnixLike())' == 'true' And Exists('$(_IkvmJdkPath)\bin\javac') ">$([System.IO.Path]::GetFullPath('$(_IkvmJdkPath)\bin\javac'))</JavaCompilerPath>
            <JavaCompilerPath Condition=" '$([MSBuild]::IsOSUnixLike())' != 'true' And Exists('$(_IkvmJdkPath)\bin\javac.exe') ">$([System.IO.Path]::GetFullPath('$(_IkvmJdkPath)\bin\javac.exe'))</JavaCompilerPath>
        </PropertyGroup>
    </Target>

    <PropertyGroup>
        <RuntimeIdentifier Condition=" '$(RuntimeIdentifier)' == 'win7-x86' ">win-x86</RuntimeIdentifier>
        <RuntimeIdentifier Condition=" '$(RuntimeIdentifier)' == 'win7-x64' ">win-x64</RuntimeIdentifier>
        <Prefer32Bit Condition=" '$(RuntimeIdentifier)' == 'win-x86' And $([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net461'))">true</Prefer32Bit>
    </PropertyGroup>
    
</Project>
