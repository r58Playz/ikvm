<Project DefaultTargets="Publish">
    <PropertyGroup>
        <!-- Not an SDK project, so Directory.Build.props (where the flavor default lives) is not imported. -->
        <IkvmJdk Condition="'$(IkvmJdk)' == ''">$(IKVM_JDK)</IkvmJdk>
        <IkvmJdk Condition="'$(IkvmJdk)' == ''">8</IkvmJdk>
        <DistDir Condition="'$(DistDir)' == ''">$(DISTDIR)</DistDir>
        <DistDir Condition="'$(DistDir)' == ''">$([System.IO.Path]::Combine('$(MSBuildThisFileDirectory)', 'dist', 'jdk$(IkvmJdk)'))</DistDir>
        <DistDir>$([System.IO.Path]::GetFullPath('$(DistDir)'))</DistDir>
        <SolutionFile>$([System.IO.Path]::Combine('$(MSBuildThisFileDirectory)', 'IKVM.sln'))</SolutionFile>
        <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
        <Platform Condition=" '$(Platform)' == '' ">Any CPU</Platform>
    </PropertyGroup>

    <ItemGroup>
        <TargetsForPublish Include="$(SolutionFile)">
            <Targets>dist%5Cdist-tools:Publish</Targets>
            <Properties>PublishDir=$(DistDir)\tools;IkvmJdk=$(IkvmJdk)</Properties>
        </TargetsForPublish>
        <TargetsForPublish Include="$(SolutionFile)">
            <Targets>dist%5Cdist-jre:Publish</Targets>
            <Properties>PublishDir=$(DistDir)\jre;IkvmJdk=$(IkvmJdk)</Properties>
        </TargetsForPublish>
        <!--<TargetsForPublish Include="$(SolutionFile)">
            <Targets>dist%5Cdist-jdk:Publish</Targets>
            <Properties>PublishDir=$(DistDir)\jdk;IkvmJdk=$(IkvmJdk)</Properties>
        </TargetsForPublish>
        <TargetsForPublish Include="$(SolutionFile)">
            <Targets>dist%5Cdist-nuget:Publish</Targets>
            <Properties>PublishDir=$(DistDir)\nuget;IkvmJdk=$(IkvmJdk)</Properties>
        </TargetsForPublish>
        <TargetsForPublish Include="$(SolutionFile)">
            <Targets>dist%5Cdist-tests:Publish</Targets>
            <Properties>PublishDir=$(DistDir)\tests;IkvmJdk=$(IkvmJdk)</Properties>
        </TargetsForPublish>-->
    </ItemGroup>

    <Target Name="Publish">
        <ItemGroup>
            <_TargetsForPublish Include="@(TargetsForPublish)">
                <Properties>%(TargetsForPublish.Properties)</Properties>
            </_TargetsForPublish>
        </ItemGroup>

        <MSBuild BuildInParallel="$(BuildInParallel)" ContinueOnError="false" Projects="@(_TargetsForPublish)" Targets="%(_TargetsForPublish.Targets)" />
    </Target>

</Project>
