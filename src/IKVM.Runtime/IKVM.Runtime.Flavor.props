<!--

    IKVM.Runtime.Flavor.props

    Selects the JDK-flavor-specific sources of IKVM.Runtime. Imported by every project that compiles them:
    IKVM.Runtime, IKVM.Runtime-ref, IKVM.Tools.Importer and IKVM.Tools.Exporter.

    The JDK 8 sources stay where they have always been. Their JDK 25 counterparts live in a parallel Jdk25\ tree
    (Jdk25\Java\Externs, Jdk25\Accessors, Jdk25\Util). A shared class whose flavors differ a lot is split into
    X.cs (shared) plus X.Jdk8.cs / X.Jdk25.cs partials; small differences use #if JDK25.

    IkvmRuntimeFlavorExclude holds the full paths of the other flavor's files.

-->

<Project>
    <PropertyGroup>
        <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
        <DefineConstants>$(DefineConstants);JDK$(IkvmJdk)</DefineConstants>
        <IkvmRuntimeDir>$(MSBuildThisFileDirectory)</IkvmRuntimeDir>
    </PropertyGroup>

    <ItemGroup Condition=" '$(IkvmJdk)' == '8' ">
        <IkvmRuntimeFlavorExclude Include="$(IkvmRuntimeDir)Jdk25\**\*.cs" />
        <IkvmRuntimeFlavorExclude Include="$(IkvmRuntimeDir)**\*.Jdk25.cs" />
    </ItemGroup>

    <ItemGroup Condition=" '$(IkvmJdk)' != '8' ">
        <IkvmRuntimeFlavorExclude Include="$(IkvmRuntimeDir)Java\Externs\java\**\*.cs" />
        <IkvmRuntimeFlavorExclude Include="$(IkvmRuntimeDir)Java\Externs\sun\**\*.cs" />
        <IkvmRuntimeFlavorExclude Include="$(IkvmRuntimeDir)Accessors\Java\**\*.cs" />
        <IkvmRuntimeFlavorExclude Include="$(IkvmRuntimeDir)Accessors\Sun\**\*.cs" />
        <IkvmRuntimeFlavorExclude Include="$(IkvmRuntimeDir)Accessors\Com\**\*.cs" />
        <IkvmRuntimeFlavorExclude Include="$(IkvmRuntimeDir)Util\Java\**\*.cs" />
        <IkvmRuntimeFlavorExclude Include="$(IkvmRuntimeDir)Util\Sun\**\*.cs" />
        <IkvmRuntimeFlavorExclude Include="$(IkvmRuntimeDir)**\*.Jdk8.cs" />
    </ItemGroup>

</Project>
