<!--

    IKVM.Runtime.Flavor.props

    Selects the JDK-flavor-specific sources of IKVM.Runtime. Imported by every project that compiles them:
    IKVM.Runtime, IKVM.Runtime-ref, IKVM.Tools.Importer and IKVM.Tools.Exporter.

    The JDK 8 sources stay where they have always been. Natives are implemented per flavor: the JDK 8 externs in
    Java\Externs\{java,sun}, the JDK 25 ones in a parallel Jdk25\Java\Externs tree. Accessors bind to Java members
    by name at run time, so they are shared; one that only one flavor uses is named X.Jdk8.cs or X.Jdk25.cs, like a
    shared class whose flavors differ a lot (X.cs plus X.Jdk8.cs / X.Jdk25.cs partials). Small differences use
    #if JDK25.

    IkvmRuntimeFlavorExclude holds the full paths of the other flavor's files.

-->

<Project>
    <PropertyGroup>
        <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
        <DefineConstants>$(DefineConstants);JDK$(IkvmJdk)</DefineConstants>
        <IkvmRuntimeDir>$(MSBuildThisFileDirectory)</IkvmRuntimeDir>
    </PropertyGroup>

    <ItemGroup Condition=" '$(IkvmJdk)' == '8' ">
        <IkvmRuntimeFlavorExclude Include="$(IkvmRuntimeDir)Jdk25\**\*.cs" />
        <IkvmRuntimeFlavorExclude Include="$(IkvmRuntimeDir)**\*.Jdk25.cs" />
    </ItemGroup>

    <ItemGroup Condition=" '$(IkvmJdk)' != '8' ">
        <!-- The JDK 8 externs whose class has the same natives in JDK 25 are shared. JDK 25's sun.misc.Unsafe has no
             natives, but its jdk.internal.misc.Unsafe ones share the JDK 8 implementation. -->
        <IkvmRuntimeFlavorSharedExtern Include="$(IkvmRuntimeDir)Java\Externs\java\lang\Double.cs" />
        <IkvmRuntimeFlavorSharedExtern Include="$(IkvmRuntimeDir)Java\Externs\java\lang\Float.cs" />
        <IkvmRuntimeFlavorSharedExtern Include="$(IkvmRuntimeDir)Java\Externs\java\lang\Runtime.cs" />
        <IkvmRuntimeFlavorSharedExtern Include="$(IkvmRuntimeDir)Java\Externs\java\lang\Shutdown.cs" />
        <IkvmRuntimeFlavorSharedExtern Include="$(IkvmRuntimeDir)Java\Externs\java\lang\System.cs" />
        <IkvmRuntimeFlavorSharedExtern Include="$(IkvmRuntimeDir)Java\Externs\java\lang\reflect\Array.cs" />
        <IkvmRuntimeFlavorSharedExtern Include="$(IkvmRuntimeDir)Java\Externs\java\util\TimeZone.cs" />
        <IkvmRuntimeFlavorSharedExtern Include="$(IkvmRuntimeDir)Java\Externs\sun\management\ClassLoadingImpl.cs" />
        <IkvmRuntimeFlavorSharedExtern Include="$(IkvmRuntimeDir)Java\Externs\sun\management\MemoryImpl.cs" />
        <IkvmRuntimeFlavorSharedExtern Include="$(IkvmRuntimeDir)Java\Externs\sun\management\ThreadImpl.cs" />
        <IkvmRuntimeFlavorSharedExtern Include="$(IkvmRuntimeDir)Java\Externs\sun\misc\Unsafe.cs" />
        <IkvmRuntimeFlavorExclude Include="$(IkvmRuntimeDir)Java\Externs\java\**\*.cs;$(IkvmRuntimeDir)Java\Externs\sun\**\*.cs" Exclude="@(IkvmRuntimeFlavorSharedExtern)" />
        <!-- generates LambdaForm code with JDK 8's internal ASM -->
        <IkvmRuntimeFlavorExclude Include="$(IkvmRuntimeDir)Util\Java\Lang\Invoke\NativeInvokerBytecodeGenerator.cs" />
        <IkvmRuntimeFlavorExclude Include="$(IkvmRuntimeDir)**\*.Jdk8.cs" />
    </ItemGroup>

</Project>
