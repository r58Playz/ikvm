<Project>
    <Import Sdk="MSTest.Sdk" Project="Sdk.props" />
    <Import Project="$(MSBuildThisFileDirectory)..\IKVM\buildTransitive\IKVM.props" />
    <Import Project="$(MSBuildThisFileDirectory)..\IKVM.MSBuild\buildTransitive\IKVM.MSBuild.props" />

    <PropertyGroup>
        <TargetFrameworks>net472;net6.0;net7.0;net8.0;net10.0</TargetFrameworks>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <PreserveCompilationContext>true</PreserveCompilationContext>
        <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
        <LangVersion>12</LangVersion>
        <RunSettingsFilePath>$(MSBuildProjectDirectory)\IKVM.Tests.runsettings</RunSettingsFilePath>
    </PropertyGroup>

    <ItemGroup>
        <None Remove="**\*.java" />
        <None Remove="Runtime\Vfs\VfsTestResource.txt" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="**\*.java" Exclude="Jdk25\**;Jdk25Gen\**;Jdk25Mr\**" />
        <EmbeddedResource Include="Runtime\Vfs\VfsTestResource.txt" />
    </ItemGroup>

    <!-- Fixtures compiled by a JDK 25 javac, for testing class file version 69 features (nestmates,
         invokedynamic bootstraps, ...). Copied to jdk25\ in the output, and as jdk25.jar for ikvmc. -->
    <ItemGroup>
        <Jdk25FixtureSource Include="Jdk25\**\*.java" />
        <!-- programs that write class files javac cannot produce (condy, a record's ObjectMethods calls without
             java.lang.Record, a sealed class's unpermitted subclass) with the ClassFile API; run before javac -->
        <Jdk25FixtureGenerator Include="Jdk25Gen\*.java" />
        <!-- a multi-release JAR: base classes (with a module-info.class) and a META-INF/versions/11 overlay -->
        <Jdk25MultiReleaseBaseSource Include="Jdk25Mr\base\**\*.java" />
        <Jdk25MultiReleaseV11Source Include="Jdk25Mr\v11\**\*.java" />
    </ItemGroup>


    <Target Name="_FindJdk25ForFixtures">
        <FindJdk Family="25">
            <Output TaskParameter="JdkPath" PropertyName="Jdk25Path" />
        </FindJdk>
        <Error Condition=" '$(Jdk25Path)' == '' " Text="IKVM.Tests compiles its class file version 69 fixtures with javac from JDK 25, which was not found." />
    </Target>

    <Target Name="_CompileJdk25Fixtures" DependsOnTargets="_FindJdk25ForFixtures" Inputs="@(Jdk25FixtureSource);@(Jdk25FixtureGenerator);@(Jdk25MultiReleaseBaseSource);@(Jdk25MultiReleaseV11Source)" Outputs="$(_Jdk25FixtureOutputPath).stamp" Condition=" '$(TargetFramework)' != '' ">
        <RemoveDir Directories="$(_Jdk25FixtureOutputPath)" />
        <MakeDir Directories="$(_Jdk25FixtureOutputPath)" />
        <Exec Command="&quot;$(Jdk25Path)/bin/java&quot; &quot;%(Jdk25FixtureGenerator.FullPath)&quot; &quot;$(_Jdk25FixtureOutputPath)classes&quot;" />
        <Exec Command="&quot;$(Jdk25Path)/bin/javac&quot; --release 25 -nowarn -cp &quot;$(_Jdk25FixtureOutputPath)classes&quot; -d &quot;$(_Jdk25FixtureOutputPath)classes&quot; @(Jdk25FixtureSource->'&quot;%(FullPath)&quot;', ' ')" />
        <Exec Command="&quot;$(Jdk25Path)/bin/jar&quot; -cf &quot;$(_Jdk25FixtureOutputPath)jdk25.jar&quot; -C &quot;$(_Jdk25FixtureOutputPath)classes&quot; ." />
        <Exec Command="&quot;$(Jdk25Path)/bin/javac&quot; --release 9 -nowarn -d &quot;$(_Jdk25FixtureOutputPath)mr-base&quot; @(Jdk25MultiReleaseBaseSource->'&quot;%(FullPath)&quot;', ' ')" />
        <Exec Command="&quot;$(Jdk25Path)/bin/javac&quot; --release 11 -nowarn -d &quot;$(_Jdk25FixtureOutputPath)mr-11&quot; @(Jdk25MultiReleaseV11Source->'&quot;%(FullPath)&quot;', ' ')" />
        <Exec Command="&quot;$(Jdk25Path)/bin/jar&quot; --create --file &quot;$(_Jdk25FixtureOutputPath)jdk25mr.jar&quot; -C &quot;$(_Jdk25FixtureOutputPath)mr-base&quot; . --release 11 -C &quot;$(_Jdk25FixtureOutputPath)mr-11&quot; ." />
        <Touch Files="$(_Jdk25FixtureOutputPath).stamp" AlwaysCreate="true" />
    </Target>

    <Target Name="CompileJdk25Fixtures" BeforeTargets="AssignTargetPaths" DependsOnTargets="_CompileJdk25Fixtures" Condition=" '$(TargetFramework)' != '' ">
        <ItemGroup>
            <_Jdk25FixtureClass Include="$(_Jdk25FixtureOutputPath)classes\**\*.class" />
            <None Include="@(_Jdk25FixtureClass)" Link="jdk25\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
            <None Include="$(_Jdk25FixtureOutputPath)jdk25.jar" Link="jdk25.jar" CopyToOutputDirectory="PreserveNewest" />
            <None Include="$(_Jdk25FixtureOutputPath)jdk25mr.jar" Link="jdk25mr.jar" CopyToOutputDirectory="PreserveNewest" />
            <FileWrites Include="@(_Jdk25FixtureClass);$(_Jdk25FixtureOutputPath)jdk25.jar;$(_Jdk25FixtureOutputPath)jdk25mr.jar;$(_Jdk25FixtureOutputPath).stamp" />
        </ItemGroup>
    </Target>

    <ItemGroup>
        <None Include="..\..\ext\helloworld\*.jar" LinkBase="helloworld">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="FluentAssertions" Version="6.12.0" />
        <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
        <PackageReference Include="System.Net.Http" Version="4.3.4" />
        <PackageReference Include="Mono.Posix" Version="7.1.0-final.1.21458.1" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\IKVM.Java.Extensions\IKVM.Java.Extensions.csproj" />
        <ProjectReference Include="..\IKVM.Image\IKVM.Image.csproj" />
        <ProjectReference Include="..\IKVM.Image.JRE\IKVM.Image.JRE.csproj" />
        <ProjectReference Include="..\IKVM.Image.JDK\IKVM.Image.JDK.csproj" />
        <ProjectReference Include="..\IKVM.Java.Tests.Util\IKVM.Java.Tests.Util.csproj" />
        <ProjectReference Include="..\IKVM.Tests.Util\IKVM.Tests.Util.csproj" />
        <ProjectReference Include="..\IKVM.Tools.Runner\IKVM.Tools.Runner.csproj" />
        <ProjectReference Include="..\IKVM.Util\IKVM.Util.csproj" />
    </ItemGroup>

    <ItemGroup>
        <DotNetClangProjectReference Include="..\libikvm-tests\libikvm-tests.clangproj" />
    </ItemGroup>

    <Choose>
        <When Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net472'))">
            <ItemGroup>
                <IncludeProjectReference Include="..\IKVM.Runtime\IKVM.Runtime.csproj">
                    <SetTargetFramework>TargetFramework=net472</SetTargetFramework>
                    <IncludeTargetPath>lib\net472\</IncludeTargetPath>
                    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
                </IncludeProjectReference>
                <IncludeProjectReference Include="..\IKVM.Java\IKVM.Java.ikvmproj">
                    <SetTargetFramework>TargetFramework=net472</SetTargetFramework>
                    <IncludeTargetPath>lib\net472\</IncludeTargetPath>
                    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
                </IncludeProjectReference>
            </ItemGroup>
        </When>
        <When Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">
            <ItemGroup>
                <IncludeProjectReference Include="..\IKVM.Runtime\IKVM.Runtime.csproj">
                    <SetTargetFramework>TargetFramework=net8.0</SetTargetFramework>
                    <IncludeTargetPath>lib\net8.0\</IncludeTargetPath>
                    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
                </IncludeProjectReference>
                <IncludeProjectReference Include="..\IKVM.Java\IKVM.Java.ikvmproj">
                    <SetTargetFramework>TargetFramework=net8.0</SetTargetFramework>
                    <IncludeTargetPath>lib\net8.0\</IncludeTargetPath>
                    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
                </IncludeProjectReference>
            </ItemGroup>
        </When>
        <When Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net6.0'))">
            <ItemGroup>
                <IncludeProjectReference Include="..\IKVM.Runtime\IKVM.Runtime.csproj">
                    <SetTargetFramework>TargetFramework=net6.0</SetTargetFramework>
                    <IncludeTargetPath>lib\net6.0\</IncludeTargetPath>
                    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
                </IncludeProjectReference>
                <IncludeProjectReference Include="..\IKVM.Java\IKVM.Java.ikvmproj">
                    <SetTargetFramework>TargetFramework=net6.0</SetTargetFramework>
                    <IncludeTargetPath>lib\net6.0\</IncludeTargetPath>
                    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
                </IncludeProjectReference>
            </ItemGroup>
        </When>
    </Choose>

    <Choose>
        <When Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net472'))">
            <ItemGroup>
                <PublishProjectReference Include="..\ikvmc\ikvmc.csproj" Condition="$(_EnabledToolRuntimes.Contains(';win-x64;'))">
                    <SetTargetFramework>TargetFramework=net472</SetTargetFramework>
                    <SetRuntimeIdentifier>RuntimeIdentifier=win-x64</SetRuntimeIdentifier>
                    <PublishTargetPath>ikvmc\net472\win-x64</PublishTargetPath>
                    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
                </PublishProjectReference>
                <PublishProjectReference Include="..\ikvmstub\ikvmstub.csproj" Condition="$(_EnabledToolRuntimes.Contains(';win-x64;'))">
                    <SetTargetFramework>TargetFramework=net472</SetTargetFramework>
                    <SetRuntimeIdentifier>RuntimeIdentifier=win-x64</SetRuntimeIdentifier>
                    <PublishTargetPath>ikvmstub\net472\win-x64</PublishTargetPath>
                    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
                </PublishProjectReference>
                <PublishProjectReference Include="..\ikvmc\ikvmc.csproj" Condition="$(_EnabledToolRuntimes.Contains(';win-arm64;'))">
                    <SetTargetFramework>TargetFramework=net472</SetTargetFramework>
                    <SetRuntimeIdentifier>RuntimeIdentifier=win-arm64</SetRuntimeIdentifier>
                    <PublishTargetPath>ikvmc\net472\win-arm64</PublishTargetPath>
                    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
                </PublishProjectReference>
                <PublishProjectReference Include="..\ikvmstub\ikvmstub.csproj" Condition="$(_EnabledToolRuntimes.Contains(';win-arm64;'))">
                    <SetTargetFramework>TargetFramework=net472</SetTargetFramework>
                    <SetRuntimeIdentifier>RuntimeIdentifier=win-arm64</SetRuntimeIdentifier>
                    <PublishTargetPath>ikvmstub\net472\win-arm64</PublishTargetPath>
                    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
                </PublishProjectReference>
            </ItemGroup>
        </When>
        <When Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net6.0'))">
            <ItemGroup>
                <PublishProjectReference Include="..\ikvmc\ikvmc.csproj" Condition="$(_EnabledToolRuntimes.Contains(';win-x64;'))">
                    <SetTargetFramework>TargetFramework=net10.0</SetTargetFramework>
                    <SetRuntimeIdentifier>RuntimeIdentifier=win-x64</SetRuntimeIdentifier>
                    <PublishTargetPath>ikvmc\net10.0\win-x64</PublishTargetPath>
                    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
                </PublishProjectReference>
                <PublishProjectReference Include="..\ikvmstub\ikvmstub.csproj" Condition="$(_EnabledToolRuntimes.Contains(';win-x64;'))">
                    <SetTargetFramework>TargetFramework=net10.0</SetTargetFramework>
                    <SetRuntimeIdentifier>RuntimeIdentifier=win-x64</SetRuntimeIdentifier>
                    <PublishTargetPath>ikvmstub\net10.0\win-x64</PublishTargetPath>
                    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
                </PublishProjectReference>
                <PublishProjectReference Include="..\ikvmc\ikvmc.csproj" Condition="$(_EnabledToolRuntimes.Contains(';win-arm64;'))">
                    <SetTargetFramework>TargetFramework=net10.0</SetTargetFramework>
                    <SetRuntimeIdentifier>RuntimeIdentifier=win-arm64</SetRuntimeIdentifier>
                    <PublishTargetPath>ikvmc\net10.0\win-arm64</PublishTargetPath>
                    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
                </PublishProjectReference>
                <PublishProjectReference Include="..\ikvmstub\ikvmstub.csproj" Condition="$(_EnabledToolRuntimes.Contains(';win-arm64;'))">
                    <SetTargetFramework>TargetFramework=net10.0</SetTargetFramework>
                    <SetRuntimeIdentifier>RuntimeIdentifier=win-arm64</SetRuntimeIdentifier>
                    <PublishTargetPath>ikvmstub\net10.0\win-arm64</PublishTargetPath>
                    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
                </PublishProjectReference>
                <PublishProjectReference Include="..\ikvmc\ikvmc.csproj" Condition="$(_EnabledToolRuntimes.Contains(';linux-x64;'))">
                    <SetTargetFramework>TargetFramework=net10.0</SetTargetFramework>
                    <SetRuntimeIdentifier>RuntimeIdentifier=linux-x64</SetRuntimeIdentifier>
                    <PublishTargetPath>ikvmc\net10.0\linux-x64</PublishTargetPath>
                    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
                </PublishProjectReference>
                <PublishProjectReference Include="..\ikvmstub\ikvmstub.csproj" Condition="$(_EnabledToolRuntimes.Contains(';linux-x64;'))">
                    <SetTargetFramework>TargetFramework=net10.0</SetTargetFramework>
                    <SetRuntimeIdentifier>RuntimeIdentifier=linux-x64</SetRuntimeIdentifier>
                    <PublishTargetPath>ikvmstub\net10.0\linux-x64</PublishTargetPath>
                    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
                </PublishProjectReference>
                <PublishProjectReference Include="..\ikvmc\ikvmc.csproj" Condition="$(_EnabledToolRuntimes.Contains(';linux-arm;'))">
                    <SetTargetFramework>TargetFramework=net10.0</SetTargetFramework>
                    <SetRuntimeIdentifier>RuntimeIdentifier=linux-arm</SetRuntimeIdentifier>
                    <PublishTargetPath>ikvmc\net10.0\linux-arm</PublishTargetPath>
                    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
                </PublishProjectReference>
                <PublishProjectReference Include="..\ikvmstub\ikvmstub.csproj" Condition="$(_EnabledToolRuntimes.Contains(';linux-arm;'))">
                    <SetTargetFramework>TargetFramework=net10.0</SetTargetFramework>
                    <SetRuntimeIdentifier>RuntimeIdentifier=linux-arm</SetRuntimeIdentifier>
                    <PublishTargetPath>ikvmstub\net10.0\linux-arm</PublishTargetPath>
                    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
                </PublishProjectReference>
                <PublishProjectReference Include="..\ikvmc\ikvmc.csproj" Condition="$(_EnabledToolRuntimes.Contains(';linux-arm64;'))">
                    <SetTargetFramework>TargetFramework=net10.0</SetTargetFramework>
                    <SetRuntimeIdentifier>RuntimeIdentifier=linux-arm64</SetRuntimeIdentifier>
                    <PublishTargetPath>ikvmc\net10.0\linux-arm64</PublishTargetPath>
                    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
                </PublishProjectReference>
                <PublishProjectReference Include="..\ikvmstub\ikvmstub.csproj" Condition="$(_EnabledToolRuntimes.Contains(';linux-arm64;'))">
                    <SetTargetFramework>TargetFramework=net10.0</SetTargetFramework>
                    <SetRuntimeIdentifier>RuntimeIdentifier=linux-arm64</SetRuntimeIdentifier>
                    <PublishTargetPath>ikvmstub\net10.0\linux-arm64</PublishTargetPath>
                    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
                </PublishProjectReference>
                <PublishProjectReference Include="..\ikvmc\ikvmc.csproj" Condition="$(_EnabledToolRuntimes.Contains(';osx-x64;'))">
                    <SetTargetFramework>TargetFramework=net10.0</SetTargetFramework>
                    <SetRuntimeIdentifier>RuntimeIdentifier=osx-x64</SetRuntimeIdentifier>
                    <PublishTargetPath>ikvmc\net10.0\osx-x64</PublishTargetPath>
                    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
                </PublishProjectReference>
                <PublishProjectReference Include="..\ikvmstub\ikvmstub.csproj" Condition="$(_EnabledToolRuntimes.Contains(';osx-x64;'))">
                    <SetTargetFramework>TargetFramework=net10.0</SetTargetFramework>
                    <SetRuntimeIdentifier>RuntimeIdentifier=osx-x64</SetRuntimeIdentifier>
                    <PublishTargetPath>ikvmstub\net10.0\osx-x64</PublishTargetPath>
                    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
                </PublishProjectReference>
                <PublishProjectReference Include="..\ikvmc\ikvmc.csproj" Condition="$(_EnabledToolRuntimes.Contains(';osx-arm64;'))">
                    <SetTargetFramework>TargetFramework=net10.0</SetTargetFramework>
                    <SetRuntimeIdentifier>RuntimeIdentifier=osx-arm64</SetRuntimeIdentifier>
