<Project>
    <Import Sdk="IKVM.Clang.Sdk" Project="Sdk.props" />
    <Import Project="$(MSBuildThisFileDirectory)..\..\..\targets\openjdk25.lib.props" />

    <!-- IKVM's libjvm (src\libjvm), built against JDK 25's jni.h and jvm.h -->
    <PropertyGroup>
        <TargetName>jvm</TargetName>
        <OutputType>dll</OutputType>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
        <EnableDefaultHeaderItems>false</EnableDefaultHeaderItems>
        <IkvmLibJvmDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)..\..\libjvm'))</IkvmLibJvmDir>
    </PropertyGroup>
    <ItemGroup>
        <AdditionalCompileOptions Include="-Wno-dll-attribute-on-redeclaration" />
        <Compile Include="$(IkvmLibJvmDir)jvm.cpp" LanguageStandard="c++11" />
        <Compile Include="$(IkvmLibJvmDir)jni.c;$(IkvmLibJvmDir)jni_vargs.c;$(IkvmLibJvmDir)jvm_emscripten_dynlib.c" LanguageStandard="c99" />
    </ItemGroup>
    <ItemGroup Condition="$(TargetIdentifier.StartsWith('linux-'))">
        <AdditionalLinkOptions Include="-Wl,--version-script=$(IkvmLibJvmDir)mapfile-vers" />
    </ItemGroup>
    <!-- the headers a native library built against this libjvm includes (libikvm-tests): jni.h and jni_md.h, which the
         JDK's make copied, and ikvm.h -->
    <ItemGroup>
        <Header Include="$(OpenJdkSupportDir)modules_include\java.base\jni.h" IncludePath="jni.h" />
        <Header Include="$(OpenJdkSupportDir)modules_include\java.base\$(OpenJdkTargetOs)\jni_md.h" IncludePath="jni_md.h" Condition=" '$(OpenJdkTargetOs)' != '' " />
        <Header Include="$(IkvmLibJvmDir)ikvm.h" IncludePath="ikvm.h" />
    </ItemGroup>

    <Import Sdk="IKVM.Clang.Sdk" Project="Sdk.targets" />
    <Import Project="$(MSBuildThisFileDirectory)..\..\..\targets\openjdk.lib.targets" />
</Project>
