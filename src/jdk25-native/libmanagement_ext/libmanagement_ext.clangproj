<Project>
    <Import Sdk="IKVM.Clang.Sdk" Project="Sdk.props" />
    <Import Project="$(MSBuildThisFileDirectory)..\..\..\targets\openjdk25.lib.props" />

    <!-- jdk.management's libmanagement_ext, which the runtime implements (jni_onload.c) -->
    <PropertyGroup>
        <TargetName>management_ext</TargetName>
        <OutputType>dll</OutputType>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
        <EnableDefaultHeaderItems>false</EnableDefaultHeaderItems>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\libjvm\libjvm.clangproj" />
    </ItemGroup>
    <ItemGroup Condition=" '$(TargetIdentifier)' != '' ">
        <Compile Include="jni_onload.c" LanguageStandard="c11" />
    </ItemGroup>

    <Import Sdk="IKVM.Clang.Sdk" Project="Sdk.targets" />
    <Import Project="$(MSBuildThisFileDirectory)..\..\..\targets\openjdk.lib.targets" />
</Project>
